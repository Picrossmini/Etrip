<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 开发期后端跑在同一局域网的 http://<电脑的局域网IP>:8000 上（具体地址写在
         lib/core/config.dart，那个文件不入版本控制，所以这里不写死；2026-10-13 真机联调
         实测是电脑移动热点网卡的 192.168.137.1:8000）。而 Android 9（targetSdk 28）
         起默认禁止明文 HTTP，不放开的话手机上请求会被系统直接拦掉、表现成「网络不佳」。
         只在 debug 构建里放开，release 保持默认不放宽（真上线该配 HTTPS 域名）。 -->
    <application android:usesCleartextTraffic="true" />
</manifest>
